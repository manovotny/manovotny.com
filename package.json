    "@vercel/speed-insights": "2.0.0",
    "clsx": "2.1.1",
    "geist": "1.7.0",
    "git-jiggy": "2.1.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rehype-unwrap-images": "1.0.0",
    "remark-sugar-high": "0.6.0",
    "tailwind-merge": "3.6.0"
  },
  "description": "My website built with Next.js, MDX, Tailwind, and Vercel.",
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@tailwindcss/postcss": "4.3.0",
    "@types/mdx": "2.0.13",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vercel/git-hooks": "1.0.0",
    "lint-staged": "17.0.5",
    "npm-check-updates": "22.2.0",
    "oxlint": "1.66.0",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tailwindcss": "4.3.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "app",
    "components",
    "lib",
    "mdx-components.tsx"
  ],
  "git": {
    "pre-commit": "lint:staged"
  },
  "license": "MIT",
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "name": "manovotny.com",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manovotny/manovotny.com.git"
  },
  "scripts": {
    "build": "next build --turbopack",
    "check": "ncu --interactive --format group",
    "check:pre": "npm run check -- --target greatest",
    "dev": "next dev",
    "fix": "npm run lint:fix && npm run format:fix",
    "format": "prettier --check --ignore-unknown .",
    "format:fix": "prettier --write --ignore-unknown .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "lint:staged": "lint-staged",
    "start": "next start",
    "test": "npm run lint && npm run format && npm run types && npm run test:unit",
    "test:unit": "tsx --test './tests/**/*.test.*'",
    "types": "tsc --noEmit"
  },
  "version": "2.0.0"
}
